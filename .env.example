NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=your-supabase-secret-key
DATABASE_URL=postgresql://postgres:[YOUR-DATABASE-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_POOLER_HOST=aws-1-your-region.pooler.supabase.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional. If omitted, the server-side Supabase secret key is used for hashing.
REGISTRATION_RATE_LIMIT_SECRET=

# WATI credentials are server-only. Never prefix these with NEXT_PUBLIC_.
WATI_API_ENDPOINT=https://live-mt-server.wati.io/YOUR_TENANT_ID
WATI_API_TOKEN=
WATI_CHANNEL=
WATI_API_VERSION=v1
WATI_WEBHOOK_SECRET=
WATI_WELCOME_TEMPLATE=persevex_lead_welcome_v1
WATI_REMINDER_TEMPLATE=persevex_lead_reminder_v1
WATI_FINAL_REMINDER_TEMPLATE=persevex_lead_final_reminder_v1

# Used by /api/cron/whatsapp. Vercel automatically sends this value as a
# Bearer token when CRON_SECRET is configured in the project.
CRON_SECRET=
# Resend email
RESEND_API_KEY=
RESEND_FROM_EMAIL=Persevex <support@persevex.com>
RESEND_REPLY_TO=support@persevex.com
RESEND_WEBHOOK_SECRET=
